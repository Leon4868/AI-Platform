{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.example/schemas/document.schema.json",
  "title": "Document Generation Contracts",
  "$defs": {
    "generationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "workflowDefinitionId", "knowledgeBaseIds", "logicalModelCode", "instructions", "sources", "outputFormat"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "templateAssetId": { "type": "string" },
        "workflowDefinitionId": { "type": "string", "minLength": 1 },
        "knowledgeBaseIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "logicalModelCode": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "label"],
            "properties": {
              "kind": { "type": "string", "enum": ["asset", "citation", "user_input"] },
              "id": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "outputFormat": { "type": "string", "enum": ["markdown", "docx", "pdf"] }
      }
    },
    "generatedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "status", "workflowRunId", "traceId", "citations", "createdAt"],
      "properties": {
        "taskId": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "running", "waiting_human", "succeeded", "failed", "cancelled"] },
        "draftAssetId": { "type": "string" },
        "workflowRunId": { "type": "string" },
        "traceId": { "type": "string" },
        "citations": { "type": "array", "items": { "$ref": "knowledge.schema.json#/$defs/citation" } },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 100 },
            "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/generationRequest" },
    { "$ref": "#/$defs/generatedDocument" }
  ]
}
