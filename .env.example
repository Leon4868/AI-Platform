# 默认不填写任何外部模型凭证，文档生产使用离线确定性 Composer。
# 本文件只记录变量名，不要把真实凭证提交到仓库。
APP_ENVIRONMENT=development
APP_DATABASE_URL=
APP_REPOSITORY_BACKEND=memory
APP_STORAGE_BACKEND=memory

# 切换为 S3 兼容存储时启用；开发环境也可指向 MinIO。
APP_S3_ENDPOINT_URL=
APP_S3_REGION=us-east-1
APP_S3_BUCKET=enterprise-ai-platform
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
APP_S3_USE_PATH_STYLE=false

# 外部模型均为可选适配器；留空时不发起外部请求。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 默认使用完全离线的确定性 Markdown composer。
# 只有显式改为 model_gateway 且配置启用路由时，文档任务才会调用外部模型。
APP_DOCUMENT_COMPOSER=deterministic
APP_MODEL_ROUTES_JSON='{"routes":[]}'
APP_MODEL_REQUEST_TIMEOUT_SECONDS=60
APP_CORS_ALLOWED_ORIGINS=

# 前端默认连接真实后端；只有显式写成 mock 才启用界面演示数据。
VITE_WORKFLOW_TRANSPORT=http
# Transport 会在该根地址后拼接 /v1/...。
VITE_API_BASE_URL=/api
VITE_DEFAULT_WORKFLOW_ID=

# Docker Compose 基础设施凭证必须在本机 .env 中设置，不提供仓库默认值。
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
